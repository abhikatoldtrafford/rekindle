# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required only if you use the OpenAI providers (captions + narration).
# Leave unset to run fully offline with local models.
OPENAI_API_KEY=

# Model used for prompt routing and narration.
REKINDLE_LLM_MODEL=gpt-5.6-luna

# Reasoning effort: none | low | medium | high | xhigh | max
REKINDLE_LLM_EFFORT=low

# Where rekindle stores its index, thumbnails and rendered memories.
REKINDLE_DATA_DIR=./data

# Path to your unpacked Google Takeout export.
REKINDLE_TAKEOUT_DIR=
