# Copy to .env and edit. .env is gitignored - never commit real keys.
#
# The defaults below are FULLY OFFLINE. rekindle makes no network calls
# unless you explicitly switch a provider to a hosted one.

# ---- Paths ----
# Where rekindle stores its index, thumbnails and rendered memories.
REKINDLE_DATA_DIR=./data

# Your unpacked Google Takeout export. Quote it - it contains a space.
REKINDLE_TAKEOUT_DIR=

# ---- Providers ----
# embed:    siglip-local (default) | fake
# caption:  none (default) | siglip-local | openai | ollama
# narrate:  template (default, no model) | openai | ollama
REKINDLE_EMBED_PROVIDER=siglip-local
REKINDLE_CAPTION_PROVIDER=none
REKINDLE_NARRATE_PROVIDER=template

# ---- Hosted model config (only used if a provider above is hosted) ----
OPENAI_API_KEY=
REKINDLE_LLM_MODEL=gpt-5.6-luna
# Reasoning effort: none | low | medium | high | xhigh | max
REKINDLE_LLM_EFFORT=low
# Override for OpenAI-compatible endpoints (Ollama, LM Studio, vLLM, ...)
REKINDLE_LLM_BASE_URL=

# ---- Safety ----
# Auto-memories are OFF by default. Unprompted memories carry the most risk;
# turn this on only after setting up your exclusion list.
REKINDLE_AUTO_MEMORIES=false

# Reject low-confidence Takeout sidecar matches (recommended: true).
REKINDLE_REJECT_HEURISTIC_SIDECARS=true

# Hard cap on hosted-model spend per memory, in USD. 0 disables the cap.
REKINDLE_COST_CAP_USD=0.50
